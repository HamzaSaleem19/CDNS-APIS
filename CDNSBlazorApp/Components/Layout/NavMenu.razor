@using CDNSBlazorApp.Services
@inject AuthService AuthService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CDNS APP</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @if (AuthService.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="excel-upload">
                    <span class="bi bi-upload-nav-menu" aria-hidden="true"></span> Excel Upload
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="instruments">
                    <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> Instruments
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="subscriptions">
                    <span class="bi bi-cash-nav-menu" aria-hidden="true"></span> Subscriptions
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="payments">
                    <span class="bi bi-credit-card-nav-menu" aria-hidden="true"></span> Payments
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="series">
                    <span class="bi bi-list-nav-menu" aria-hidden="true"></span> Series
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="instituations">
                    <span class="bi bi-building-nav-menu" aria-hidden="true"></span> Instituations
                </NavLink>
            </div>

            @if (AuthService.HasRole("Admin"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="user-management">
                        <span class="bi bi-people-nav-menu" aria-hidden="true"></span> User Management
                    </NavLink>
                </div>
            }

            <div class="nav-item px-3">
                <a class="nav-link" href="#" @onclick="HandleLogout" @onclick:preventDefault>
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
                </a>
            </div>

            <div class="user-info px-3">
                <small>Logged in as: <strong>@AuthService.UserName</strong></small>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private void HandleLogout()
    {
        AuthService.Logout();
    }
}

