@page "/user-management"
@using System.Net.Http.Json
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>User Management - CDNS Blazor App</PageTitle>

<div class="user-management-container">
    <div class="page-header">
        <h2>User Management</h2>
        <p>Manage users and their roles</p>
    </div>

    @if (!AuthService.HasRole("Admin"))
    {
        <div class="alert alert-warning">
            You do not have permission to access this page.
        </div>
        return;
    }

    <div class="actions-bar">
        <button class="btn btn-primary" @onclick="ShowCreateUserModal">
            + Create New User
        </button>
        <button class="btn btn-refresh" @onclick="LoadUsers">
            🔄 Refresh
        </button>
    </div>

    @if (successMessage != null)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (users == null)
    {
        <div class="loading">Loading users...</div>
    }
    else
    {
        <div class="users-table">
            <table>
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Full Name</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td><strong>@user.UserName</strong></td>
                            <td>@user.Email</td>
                            <td>@user.FullName</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge">@role</span>
                                }
                            </td>
                            <td>
                                <span class="@(user.IsActive ? "status-active" : "status-inactive")">
                                    @(user.IsActive ? "● Active" : "● Inactive")
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="action-buttons">
                                @if (user.IsActive)
                                {
                                    <button class="btn-action btn-disable" @onclick="@(() => ToggleUserStatus(user.Id, false))">
                                        Disable
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-action btn-enable" @onclick="@(() => ToggleUserStatus(user.Id, true))">
                                        Enable
                                    </button>
                                }
                                <button class="btn-action btn-delete" @onclick="@(() => DeleteUser(user.Id, user.UserName))">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <p>Total Users: <strong>@users.Count</strong></p>
            </div>
        </div>
    }

    <!-- Create User Modal -->
    @if (showCreateModal)
    {
        <div class="modal-overlay" @onclick="HideCreateUserModal">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3>Create New User</h3>
                    <button class="modal-close" @onclick="HideCreateUserModal">×</button>
                </div>

                <EditForm Model="@newUser" OnValidSubmit="CreateUser">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Username *</label>
                        <InputText @bind-Value="newUser.UserName" class="form-control" placeholder="Enter username" />
                        <ValidationMessage For="@(() => newUser.UserName)" />
                    </div>

                    <div class="form-group">
                        <label>Email *</label>
                        <InputText @bind-Value="newUser.Email" class="form-control" placeholder="Enter email" type="email" />
                        <ValidationMessage For="@(() => newUser.Email)" />
                    </div>

                    <div class="form-group">
                        <label>Full Name *</label>
                        <InputText @bind-Value="newUser.FullName" class="form-control" placeholder="Enter full name" />
                        <ValidationMessage For="@(() => newUser.FullName)" />
                    </div>

                    <div class="form-group">
                        <label>Password *</label>
                        <InputText @bind-Value="newUser.Password" class="form-control" placeholder="Enter password" type="password" />
                        <ValidationMessage For="@(() => newUser.Password)" />
                    </div>

                    <div class="form-group">
                        <label>Role *</label>
                        <InputSelect @bind-Value="newUser.Role" class="form-control">
                            <option value="">Select Role</option>
                            <option value="Admin">Admin</option>
                            <option value="Manager">Manager</option>
                            <option value="User">User</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => newUser.Role)" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="HideCreateUserModal">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@isCreating">
                            @if (isCreating)
                            {
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create User</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <div class="back-button">
        <button class="btn-back" @onclick="@(() => NavigationManager.NavigateTo("/"))">
            ← Back to Dashboard
        </button>
    </div>
</div>

<style>
    .user-management-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .page-header h2 {
        color: #333;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .page-header p {
        color: #666;
        font-size: 16px;
    }

    .actions-bar {
        margin-bottom: 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-primary {
        padding: 12px 25px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-refresh {
        padding: 12px 25px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-refresh:hover {
        background: #218838;
        transform: translateY(-2px);
    }

    .users-table {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        margin-bottom: 20px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    th {
        padding: 15px;
        text-align: left;
        font-weight: 600;
    }

    td {
        padding: 15px;
        border-bottom: 1px solid #eee;
    }

    tr:hover {
        background-color: #f8f9fa;
    }

    .action-buttons {
        white-space: nowrap;
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        background: #667eea;
        color: white;
        border-radius: 12px;
        font-size: 12px;
        margin-right: 5px;
    }

    .status-active {
        color: #28a745;
        font-weight: 600;
    }

    .status-inactive {
        color: #dc3545;
        font-weight: 600;
    }

    .btn-action {
        padding: 6px 15px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.3s;
        margin-right: 5px;
    }

    .btn-enable {
        background: #28a745;
        color: white;
    }

    .btn-enable:hover {
        background: #218838;
    }

    .btn-disable {
        background: #ffc107;
        color: #333;
    }

    .btn-disable:hover {
        background: #e0a800;
    }

    .btn-delete {
        background: #dc3545;
        color: white;
    }

    .btn-delete:hover {
        background: #c82333;
    }

    .table-footer {
        padding: 15px;
        background: #f8f9fa;
        text-align: right;
        border-top: 2px solid #dee2e6;
    }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 12px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        padding: 20px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header h3 {
        margin: 0;
        color: #333;
        font-size: 24px;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 30px;
        color: #999;
        cursor: pointer;
        line-height: 1;
    }

    .modal-close:hover {
        color: #333;
    }

    .modal-content form {
        padding: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 5px;
        color: #333;
        font-weight: 500;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
        box-sizing: border-box;
    }

    .form-control:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .validation-message {
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid #eee;
    }

    .btn-secondary {
        padding: 10px 20px;
        background: #6c757d;
        color: white;
        border: none;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-secondary:hover {
        background: #5a6268;
    }

    .loading {
        text-align: center;
        padding: 50px;
        color: #666;
        font-size: 18px;
    }

    .alert {
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-success {
        background: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
    }

    .alert-danger {
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
    }

    .alert-warning {
        background: #fff3cd;
        border: 1px solid #ffeeba;
        color: #856404;
    }

    .back-button {
        text-align: center;
        margin-top: 30px;
    }

    .btn-back {
        padding: 12px 30px;
        background: #6c757d;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }
</style>

@code {
    private List<UserDto>? users;
    private bool showCreateModal = false;
    private bool isCreating = false;
    private CreateUserModel newUser = new();
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        errorMessage = null;
        try
        {
            users = await Http.GetFromJsonAsync<List<UserDto>>("/api/usermanagement/users");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
    }

    private void ShowCreateUserModal()
    {
        newUser = new CreateUserModel();
        showCreateModal = true;
        successMessage = null;
        errorMessage = null;
    }

    private void HideCreateUserModal()
    {
        showCreateModal = false;
        newUser = new CreateUserModel();
    }

    private async Task CreateUser()
    {
        isCreating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("/api/usermanagement/users", newUser);

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"User '{newUser.UserName}' created successfully!";
                HideCreateUserModal();
                await LoadUsers();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to create user: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating user: {ex.Message}";
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task ToggleUserStatus(string userId, bool newStatus)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var user = users?.FirstOrDefault(u => u.Id == userId);
            if (user == null) return;

            var updateModel = new UpdateUserModel
            {
                FullName = user.FullName ?? "",
                Email = user.Email,
                IsActive = newStatus
            };

            var response = await Http.PutAsJsonAsync($"/api/usermanagement/users/{userId}", updateModel);

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"User {(newStatus ? "enabled" : "disabled")} successfully!";
                await LoadUsers();
            }
            else
            {
                errorMessage = "Failed to update user status";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error updating user status: {ex.Message}";
        }
    }

    private async Task DeleteUser(string userId, string userName)
    {
        if (userName == "Admin")
        {
            errorMessage = "Cannot delete the Admin user!";
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.DeleteAsync($"/api/usermanagement/users/{userId}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"User '{userName}' deleted successfully!";
                await LoadUsers();
            }
            else
            {
                errorMessage = "Failed to delete user";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting user: {ex.Message}";
        }
    }

    public class UserDto
    {
        public string Id { get; set; } = string.Empty;
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? FullName { get; set; }
        public bool IsActive { get; set; }
        public DateTime CreatedAt { get; set; }
        public List<string> Roles { get; set; } = new();
    }

    public class CreateUserModel
    {
        [Required(ErrorMessage = "Username is required")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Username must be between 3 and 50 characters")]
        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Full name is required")]
        [StringLength(100, ErrorMessage = "Full name cannot exceed 100 characters")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [StringLength(100, MinimumLength = 4, ErrorMessage = "Password must be at least 4 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Role is required")]
        public string Role { get; set; } = string.Empty;
    }

    public class UpdateUserModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public bool IsActive { get; set; }
    }
}
