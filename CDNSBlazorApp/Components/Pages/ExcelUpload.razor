@page "/excel-upload"
@using CDNSBlazorApp.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject HttpClient Http

<PageTitle>Excel Upload - CDNS Blazor App</PageTitle>

<div class="excel-upload-container">
    <div class="page-header">
        <h2>Excel File Upload</h2>
        <p>Upload Excel files to import data into the system</p>
    </div>

    <div class="upload-grid">
        <div class="upload-card">
            <h3>📋 Instituation</h3>
            <p>Upload Instituation data</p>
            <InputFile OnChange="@(e => HandleFileUpload(e, "instituation"))" accept=".xlsx,.xls" class="file-input" id="instituation-file" />
            <label for="instituation-file" class="btn-upload">
                Choose File
            </label>
            @if (uploadStatus.ContainsKey("instituation"))
            {
                <div class="@GetStatusClass(uploadStatus["instituation"])">
                    @uploadStatus["instituation"]
                </div>
            }
        </div>

        <div class="upload-card">
            <h3>📊 Instrument</h3>
            <p>Upload Instrument data</p>
            <InputFile OnChange="@(e => HandleFileUpload(e, "instrument"))" accept=".xlsx,.xls" class="file-input" id="instrument-file" />
            <label for="instrument-file" class="btn-upload">
                Choose File
            </label>
            @if (uploadStatus.ContainsKey("instrument"))
            {
                <div class="@GetStatusClass(uploadStatus["instrument"])">
                    @uploadStatus["instrument"]
                </div>
            }
        </div>

        <div class="upload-card">
            <h3>📈 Series</h3>
            <p>Upload Series data</p>
            <InputFile OnChange="@(e => HandleFileUpload(e, "series"))" accept=".xlsx,.xls" class="file-input" id="series-file" />
            <label for="series-file" class="btn-upload">
                Choose File
            </label>
            @if (uploadStatus.ContainsKey("series"))
            {
                <div class="@GetStatusClass(uploadStatus["series"])">
                    @uploadStatus["series"]
                </div>
            }
        </div>

        <div class="upload-card">
            <h3>🔄 Series Pattern</h3>
            <p>Upload Series Pattern data</p>
            <InputFile OnChange="@(e => HandleFileUpload(e, "seriespattern"))" accept=".xlsx,.xls" class="file-input" id="seriespattern-file" />
            <label for="seriespattern-file" class="btn-upload">
                Choose File
            </label>
            @if (uploadStatus.ContainsKey("seriespattern"))
            {
                <div class="@GetStatusClass(uploadStatus["seriespattern"])">
                    @uploadStatus["seriespattern"]
                </div>
            }
        </div>

        <div class="upload-card">
            <h3>💰 Subscription</h3>
            <p>Upload Subscription data</p>
            <InputFile OnChange="@(e => HandleFileUpload(e, "subscription"))" accept=".xlsx,.xls" class="file-input" id="subscription-file" />
            <label for="subscription-file" class="btn-upload">
                Choose File
            </label>
            @if (uploadStatus.ContainsKey("subscription"))
            {
                <div class="@GetStatusClass(uploadStatus["subscription"])">
                    @uploadStatus["subscription"]
                </div>
            }
        </div>

        <div class="upload-card">
            <h3>💳 Payment</h3>
            <p>Upload Payment data</p>
            <InputFile OnChange="@(e => HandleFileUpload(e, "payment"))" accept=".xlsx,.xls" class="file-input" id="payment-file" />
            <label for="payment-file" class="btn-upload">
                Choose File
            </label>
            @if (uploadStatus.ContainsKey("payment"))
            {
                <div class="@GetStatusClass(uploadStatus["payment"])">
                    @uploadStatus["payment"]
                </div>
            }
        </div>
    </div>

    <div class="back-button">
        <button class="btn-back" @onclick="@(() => NavigationManager.NavigateTo("/"))">
            ← Back to Dashboard
        </button>
    </div>
</div>

<style>
    .excel-upload-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .page-header h2 {
        color: #333;
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .page-header p {
        color: #666;
        font-size: 16px;
    }

    .upload-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 30px;
    }

    .upload-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .upload-card h3 {
        color: #333;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .upload-card p {
        color: #666;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .file-input {
        display: none;
    }

    .btn-upload {
        display: inline-block;
        padding: 12px 30px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
    }

    .btn-upload:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    .status-message {
        margin-top: 15px;
        padding: 10px;
        border-radius: 5px;
        font-size: 14px;
    }

    .status-success {
        background-color: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .status-error {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .status-loading {
        background-color: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .back-button {
        text-align: center;
        margin-top: 30px;
    }

    .btn-back {
        padding: 12px 30px;
        background: #6c757d;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-back:hover {
        background: #5a6268;
        transform: translateY(-2px);
    }
</style>

@code {
    private Dictionary<string, string> uploadStatus = new();

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e, string entityType)
    {
        uploadStatus[entityType] = "Uploading...";
        StateHasChanged();

        try
        {
            var file = e.File;
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10485760)); // 10MB max
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync($"/api/excelupload/{entityType}", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                uploadStatus[entityType] = $"✓ Upload successful!";
            }
            else
            {
                uploadStatus[entityType] = $"✗ Upload failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            uploadStatus[entityType] = $"✗ Error: {ex.Message}";
        }

        StateHasChanged();
    }

    private string GetStatusClass(string status)
    {
        if (status.Contains("successful")) return "status-message status-success";
        if (status.Contains("failed") || status.Contains("Error")) return "status-message status-error";
        return "status-message status-loading";
    }
}
